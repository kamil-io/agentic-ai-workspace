    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE public.threads_outbound_logs\nSET approval_status=CASE WHEN $1='approve' THEN 'APPROVAL_CLAIMED' ELSE 'REJECTED_BY_HUMAN' END,\npublish_status=CASE WHEN $1='approve' THEN 'PUBLISHING' ELSE 'REJECTED' END,\napproved_by_telegram_user_id=$2, approval_claimed_at=CURRENT_TIMESTAMP,\napproval_execution_id=$4,\napproved_reply=CASE WHEN $1='approve' THEN draft_reply ELSE NULL END\nWHERE id=$3 AND $1 IN ('approve','reject')\nAND approval_status='PENDING_HUMAN_APPROVAL' AND publish_status='UNPUBLISHED'\nAND approval_expires_at > CURRENT_TIMESTAMP\nAND ($1='reject' OR (post_id ~ '^[1-9][0-9]*$' AND draft_reply ~ '[^[:space:]]'))\nRETURNING *;",
        "options": {
          "queryReplacement": "={{ [ $('Parse Telegram Callback Data').first().json.action, $('Parse Telegram Callback Data').first().json.reviewerId, $('Parse Telegram Callback Data').first().json.approvalId, $execution.id ] }}"
        }
      },
      "id": "d8b65794-6e66-439d-bb9a-393e0550d0d6",
      "name": "Claim Pending Approval",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        -1552,
        4304
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const cb=$('Parse Telegram Callback Data').first().json;\nconst row=$input.first()?.json || {};\nif (!row.id || String(row.id)!==String(cb.approvalId)) throw new Error('Approval missing, expired, invalid or already consumed');\nif (String(row.approved_by_telegram_user_id)!==String(cb.reviewerId) || String(row.approval_execution_id)!==String($execution.id)) throw new Error('Approval claim owner mismatch');\nconst expires=Date.parse(row.approval_expires_at), claimed=Date.parse(row.approval_claimed_at);\nif (!Number.isFinite(expires) || !Number.isFinite(claimed) || expires<=claimed) throw new Error('Invalid approval expiry');\nconst approved=cb.action==='approve' && row.approval_status==='APPROVAL_CLAIMED' && row.publish_status==='PUBLISHING';\nconst rejected=cb.action==='reject' && row.approval_status==='REJECTED_BY_HUMAN' && row.publish_status==='REJECTED';\nif (!approved && !rejected) throw new Error('Approval has already been used or is not pending');\nif (approved && (!/^[1-9]\\d*$/.test(String(row.post_id || '')) || typeof row.approved_reply!=='string' || !row.approved_reply.trim())) throw new Error('Missing approved draft or target');\nreturn [{json:{...cb,approvalId:row.id,post_id:row.post_id,username:row.username,draft_reply:row.approved_reply,matched_topic:row.matched_topic}}];"
      },
