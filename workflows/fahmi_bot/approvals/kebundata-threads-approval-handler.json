              "id": "cond-valid",
              "leftValue": "={{ $('Parse Telegram Callback Data').first().json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
