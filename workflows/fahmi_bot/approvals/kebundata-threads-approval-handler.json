        "additionalFields": {
          "text": "={{ $json.action === 'approve' ? '✅ Kelulusan diterima! Memproses balasan Threads...' : '❌ Keputusan ditolak.' }}",
          "show_alert": true
        }
      },
      "id": "86514ac8-4766-4865-bc63-1e3e9a3515d5",
