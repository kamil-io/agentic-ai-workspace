    {
      "parameters": {
        "jsCode": "const raw=$input.first().json;\nconst cb=(raw.body || raw).callback_query;\nconst match=/^(approve|reject)_log_([1-9]\\d*)$/.exec(cb?.data || '');\nconst expectedReviewerId='YOUR_TELEGRAM_REVIEWER_ID';\nconst expectedChatId='YOUR_TELEGRAM_CHAT_ID';\nconst reviewerId=String(cb?.from?.id || '');\nconst chatId=String(cb?.message?.chat?.id || '');\nif (!match || !cb?.id || reviewerId!==expectedReviewerId || chatId!==expectedChatId) return [];\nreturn [{json:{valid:true,action:match[1],approvalId:match[2],reviewerId,chatId,callbackQueryId:cb.id,messageId:cb.message.message_id,config:{threadsUserId:'YOUR_THREADS_USER_ID',telegramChatId:expectedChatId}}}];"
      },
      "id": "25954dc9-6132-4d71-93fc-3664d1bd9067",
      "name": "Parse Telegram Callback Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
