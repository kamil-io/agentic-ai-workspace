          ]
        }
      },
      "id": "kb-token-0004",
      "name": "Fetch Account Profile & ID",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "const me = $input.first().json;\nconst tokenData = $('Exchange Token (Get 60-Day Token)').first().json;\nconst inputData = $('Input Threads Credentials').first().json;\n\nconst longLivedToken = tokenData.access_token || '';\nconst expiresInDays = Math.round((tokenData.expires_in || 5184000) / 86400);\n\nconst envBlock = `# Meta Threads Credentials\\nTHREADS_APP_ID=${inputData.app_id}\\nTHREADS_APP_SECRET=${inputData.client_secret}\\nTHREADS_USER_ID=${me.id}\\nTHREADS_ACCESS_TOKEN=${longLivedToken}`;\n\nreturn {\n  json: {\n    status: \"SUCCESS\",\n    username: me.username,\n    account_id: me.id,\n    account_name: me.name,\n    token_type: tokenData.token_type || \"bearer\",\n    expires_in_days: `${expiresInDays} days`,\n    long_lived_access_token: longLivedToken,\n    env_formatted_copy_paste: envBlock\n  }\n};"
      },
      "id": "kb-token-0005",
